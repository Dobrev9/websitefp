<% content_for :title, "Login - English Class by Florina Pricop" %>
<% content_for :description, "Access your secure English class materials and resources." %>

<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%); margin-top: -70px; padding-top: 70px;">
  <div class="row w-100 justify-content-center">
    <div class="col-12 col-md-6 col-lg-4">
      <div class="card shadow-lg border-0 rounded-3">
        <div class="card-body p-5">
          <!-- Header -->
          <div class="text-center mb-4">
            <div class="mb-3">
              <div class="bg-primary rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                <svg class="text-white" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/>
                </svg>
              </div>
            </div>
            <h2 class="fw-bold text-dark mb-2">Welcome Back</h2>
            <p class="text-muted">Enter your password to access class materials</p>
          </div>

          <!-- Password Form -->
          <%= form_with url: login_path, method: :post, local: true, html: { class: "needs-validation", novalidate: true } do |form| %>
            <div class="mb-4">
              <%= form.label :password, "Password", class: "form-label fw-semibold" %>
              <div class="position-relative">
                <%= form.password_field :password,
                    id: "password",
                    class: "form-control form-control-lg",
                    placeholder: "Enter your password",
                    required: true,
                    autocomplete: "current-password",
                    style: "padding-right: 45px;" %>
                <button type="button" 
                        onclick="togglePasswordVisibility()" 
                        class="btn position-absolute text-muted border-0"
                        style="right: 10px; top: 50%; transform: translateY(-50%); background: none; padding: 5px; z-index: 10;">
                  <!-- Eye icon (hidden state) -->
                  <svg id="eyeHidden" width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z"/>
                  </svg>
                  <!-- Eye open icon (visible state) -->
                  <svg id="eyeVisible" width="20" height="20" fill="currentColor" viewBox="0 0 24 24" style="display: none;">
                    <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                  </svg>
                </button>
              </div>
              <div class="invalid-feedback">
                Please enter your password.
              </div>
            </div>

            <!-- Error Message -->
            <% if flash[:alert] %>
              <div class="alert alert-danger mb-4" role="alert">
                <svg class="me-2" width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
                </svg>
                <%= flash[:alert] %>
              </div>
            <% end %>

            <!-- Submit Button -->
            <%= form.submit "Access Class Materials",
                class: "btn btn-primary btn-lg w-100 fw-semibold",
                style: "background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%); border: none;" %>
          <% end %>

          <!-- Additional Info -->
          <div class="text-center mt-4">
            <p class="text-muted small mb-2">
              <svg class="me-1" width="14" height="14" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/>
              </svg>
              Secure access to your learning materials
            </p>
            <%= link_to "← Back to Home", root_path,
                class: "text-decoration-none fw-semibold",
                style: "color: #1e40af;" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>

</script>

<!-- Form Validation Script -->
<% content_for :javascript do %>
  <%= javascript_include_tag 'login', defer: true %>
<% end %>